{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": ["Bash(sudo *)"]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anduin-agent-skills": {
      "source": {
        "source": "directory",
        "path": "/home/tuan/Workspaces/anduin/agent-skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "allowUnixSockets": false,
    "credentials": {
      "envVars": [
        { "name": "HF_TOKEN", "mode": "deny" },
        { "name": "K3S_DB_PASS", "mode": "deny" },
        { "name": "GH_NPM_READ_TOKEN", "mode": "deny" },
        { "name": "GEMINI_API_KEY", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "LITELLM_API_KEY", "mode": "deny" },
        { "name": "LLAMA_CPP_TOKEN", "mode": "deny" },
        { "name": "LLAMA_CPP_TOKEN", "mode": "deny" },
        { "name": "ANDUIN_INFISICAL_CLIENT_SECRET", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" }
      ]
    }
  },
  "effortLevel": "high"
}
